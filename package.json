{
  "name": "claude-cost",
  "version": "0.1.0",
  "private": true,
  "description": "Electron app showing API-equivalent cost of Claude Code usage",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "summary": "node -e \"const u=require('./usage.js');u.fetchPrices().then(p=>u.summarize({prices:p})).then(s=>console.log(JSON.stringify({total:s.total,records:s.records,unpriced:s.unpriced,files:s.files,days:Object.fromEntries(Object.entries(s.days).sort().slice(-5))},null,1)))\""
  },
  "devDependencies": {
    "electron": "44.7.2"
  }
}
