{
  "name": "claude-cost",
  "version": "0.1.0",
  "private": true,
  "description": "Electron app showing API-equivalent cost of Claude Code usage",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "summary": "node -e \"const u=require('./usage.js');u.fetchPrices().then(p=>u.summarize({prices:p})).then(s=>{for(const d of Object.keys(s.days).sort().slice(-7)){const c=s.days[d].costs;console.log(d,(c.input+c.cacheRead+c.cacheWrite+c.output).toFixed(2))}})\""
  },
  "devDependencies": {
    "electron": "44.7.2"
  },
  "license": "MIT"
}
